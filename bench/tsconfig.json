{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2024", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false
  },
  "include": ["./*.ts", "../src/**/*.ts"]
}
